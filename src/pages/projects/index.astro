---
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/components/custom/ProjectCard.astro";
import { getCollection } from "astro:content";
import { t } from "@/i18n/utils";
const allProjects = await getCollection("projects");
---

<Base title={t("projects.title")} description={t("projects.description")}>
  <div>
    <header class="page-heading"><p class="eyebrow">Independent projects & experiments</p><h1>Built out of curiosity.</h1><p>Tools for everyday work. Games for good company. Explore the things I make.</p></header>

    <div class="project-grid all-projects">
      {allProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          disclaimer={project.data.disclaimer}
          stack={project.data.stack}
          githubUrl={project.data.githubUrl}
          liveUrl={project.data.liveUrl}
          releasesUrl={project.data.releasesUrl}
        />
      ))}
    </div>
  </div>
</Base>
