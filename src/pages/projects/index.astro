---
import { getCollection } from "astro:content";
import Illustration from "@/components/custom/Illustration.astro";
import PageHeader from "@/components/custom/PageHeader.astro";
import ProjectCard from "@/components/custom/ProjectCard.astro";
import { illustrations } from "@/data/illustrations";
import { t } from "@/i18n/utils";
import Base from "@/layouts/Base.astro";

const projects = await getCollection("projects");
---

<Base title={t("projects.title")} description={t("projects.description")}>
  <div class="shell">
    <PageHeader title={t("projects.title")} />
    <Illustration
      class="projects-banner"
      desktop={{ image: illustrations.heroDesktop, position: "62% 42%" }}
      sizes="(min-width: 84rem) 84rem, 100vw"
      widths={[640, 1024, 1440, 1920]}
    />
    <ul class="projects-grid" role="list">
      {
        projects.map((project) => (
          <li>
            <ProjectCard id={project.id} project={project.data} variant="full" headingLevel="h2" />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .shell :global(.projects-banner) {
    aspect-ratio: 5 / 2;
    border-radius: 3px;
  }

  .projects-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 40rem) {
    .shell :global(.projects-banner) {
      aspect-ratio: 4 / 1;
    }
  }

  @media (min-width: 64rem) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
