---
import { getCollection } from "astro:content";
import ArticleRow from "@/components/custom/ArticleRow.astro";
import ButtonLink from "@/components/custom/ButtonLink.astro";
import Illustration from "@/components/custom/Illustration.astro";
import ProjectCard from "@/components/custom/ProjectCard.astro";
import SectionHeading from "@/components/custom/SectionHeading.astro";
import { illustrations } from "@/data/illustrations";
import { RESUME_HREF } from "@/data/navigation";
import { t } from "@/i18n/utils";
import Base from "@/layouts/Base.astro";
import { sortByDate } from "@/lib/utils";

const [allArticles, featuredProjects] = await Promise.all([
  getCollection("articles", ({ data }) => !data.draft),
  getCollection("projects", ({ data }) => data.featured),
]);
const latestArticles = sortByDate(allArticles).slice(0, 3);
---

<Base description={t("home.description")}>
  <section class="hero" aria-labelledby="hero-name">
    <Illustration
      class="hero-art"
      desktop={{ image: illustrations.heroDesktop, position: "65% 50%" }}
      mobile={{ image: illustrations.heroMobile, position: "50% 50%" }}
      priority
    />
    <div class="hero-copy shell">
      <p class="hero-role">{t("site.role")}</p>
      <h1 id="hero-name">{t("site.name")}</h1>
      <div class="hero-actions">
        <ButtonLink href="#selected-work" icon="arrow-down">{t("home.exploreWork")}</ButtonLink>
        <ButtonLink href={RESUME_HREF} variant="secondary" icon="download" download>
          {t("links.downloadResume")}
        </ButtonLink>
      </div>
    </div>
  </section>

  <section id="selected-work" class="home-section shell" aria-labelledby="work-title">
    <SectionHeading
      id="work-title"
      title={t("home.selectedWork")}
      count={featuredProjects.length}
      link={{ href: "/projects", label: t("home.allProjects") }}
    />
    <ul class="featured-grid" role="list">
      {
        featuredProjects.map((project) => (
          <li>
            <ProjectCard id={project.id} project={project.data} variant="featured" />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-section shell" aria-labelledby="articles-title">
    <SectionHeading
      id="articles-title"
      title={t("home.articles")}
      link={{ href: "/articles", label: t("home.allArticles") }}
    />
    <ul class="latest-grid" role="list">
      {
        latestArticles.map((article) => (
          <li>
            <ArticleRow href={`/articles/${article.id}`} article={article.data} variant="compact" />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /*
   * The illustration is a light scene in both themes, so the hero keeps light tokens.
   * Narrow screens stack the copy on the sky colours sampled from the top of hero-mobile,
   * then the whole illustration fades in below it; wide screens overlay the copy on the sky.
   */
  .hero {
    --ink: var(--color-abyss);
    --ink-muted: var(--color-indigo);
    --surface-page: #f3ebdf;
    --surface-raised: var(--color-ivory);
    --focus-ring: var(--color-abyss);

    display: grid;
    background: linear-gradient(to bottom, #ae90d8, #c595d1);
    color: var(--ink);
    color-scheme: light;
  }

  .hero :global(.hero-art) {
    order: 2;
    aspect-ratio: 4 / 3;
    margin-top: -4rem;
    mask-image: linear-gradient(to bottom, transparent, #000 35%);
  }

  .hero-copy {
    z-index: 1;
    padding-block: 2.5rem 1rem;
  }

  .hero-role {
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(3rem, 2rem + 5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .home-section {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    scroll-margin-top: 1.5rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
  }

  .latest-grid {
    border-top: 1px solid var(--rule);
  }

  .latest-grid > li {
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 64rem) {
    .hero {
      height: clamp(26rem, 37vw, 40rem);
      background: none;
    }

    .hero > :global(*) {
      grid-area: 1 / 1;
    }

    .hero :global(.hero-art) {
      aspect-ratio: auto;
      margin-top: 0;
      mask-image: none;
    }

    .hero-copy {
      align-self: center;
      padding-block: 0;
    }

    .latest-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0 2.5rem;
      border-top: 0;
    }

    .latest-grid > li {
      border-top: 1px solid var(--rule);
    }
  }
</style>
