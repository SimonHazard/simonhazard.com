---
interface Props {
  title: string;
  description: string;
  disclaimer?: string;
  stack: string[];
  githubUrl?: string;
  liveUrl?: string;
  releasesUrl?: string;
}
import { ArrowUpRight, Layers, Mic, ScanEye, StickyNote } from "@lucide/astro";
const { title, description, disclaimer, stack, githubUrl, liveUrl, releasesUrl } = Astro.props;
const identities: Record<string, { label: string; accent: string; icon: typeof Layers }> = {
  Charon: { label: "Capture / Organize", accent: "lime", icon: StickyNote },
  MemeOver: { label: "Connect / Share", accent: "violet", icon: Layers },
  Mimikit: { label: "Dub / Play", accent: "orange", icon: Mic },
  Undercover: { label: "Bluff / Discover", accent: "cyan", icon: ScanEye },
};
const identity = identities[title] ?? {
  label: "Independent project",
  accent: "lime",
  icon: Layers,
};
const Icon = identity.icon;
---
<article class:list={["project-card", `project-${identity.accent}`]} data-reveal>
  <div class="project-visual" aria-hidden="true">
    <span class="visual-label label-ui">{identity.label}</span>
    <div class="project-emblem"><span class="emblem-frame"></span><span class="emblem-frame frame-two"></span><Icon size={54} stroke-width={1.2} /></div>
    <span class="visual-word">{title}</span>
    <span class="visual-cross">+</span>
  </div>
  <div class="project-content">
    <h3>{title}</h3>
    <p>{description}</p>
    {disclaimer && <p class="project-disclaimer">{disclaimer}</p>}
    <ul class="tech-list" aria-label={`${title} technologies`}>{stack.map((tech) => <li>{tech}</li>)}</ul>
    <div class="project-links">
      {liveUrl && <a class="text-link" href={liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${title} website`}>Visit project <ArrowUpRight size={15} /></a>}
      {releasesUrl && <a class="text-link" href={releasesUrl} target="_blank" rel="noopener noreferrer" aria-label={`Download ${title} on GitHub Releases`}>Download <ArrowUpRight size={15} /></a>}
      {githubUrl && <a class="text-link source-link" href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${title} source on GitHub`}>Source <ArrowUpRight size={15} /></a>}
    </div>
  </div>
</article>
