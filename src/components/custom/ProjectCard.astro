---
import { AppWindow, ArrowUpRight, Code, Download } from "@lucide/astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { projectLogo } from "@/data/project-logos";
import { t } from "@/i18n/utils";
import ButtonLink from "./ButtonLink.astro";
import Tag from "./Tag.astro";

interface Props {
  /** Id of the project file in src/content/projects. */
  id: string;
  project: CollectionEntry<"projects">["data"];
  /** `featured` for the home page grid, `full` for the projects page. */
  variant: "featured" | "full";
  headingLevel?: "h2" | "h3";
}

const { id, project, variant, headingLevel = "h3" } = Astro.props;
const { title, description, disclaimer, highlights, stack, liveUrl, githubUrl, releasesUrl } =
  project;
const decommissioned = project.status === "decommissioned";
const logo = projectLogo(id);
const Heading = headingLevel;
// A decommissioned project keeps its data, but its site no longer exists: never link to it.
const siteUrl = decommissioned ? undefined : liveUrl;
const primaryUrl = siteUrl ?? releasesUrl ?? githubUrl;
const hasActions = Boolean(siteUrl || releasesUrl || githubUrl);
const shownStack = variant === "featured" ? stack.slice(0, 3) : stack;
---

<article class:list={["project", `project--${variant}`]}>
  <span class:list={["project-mark", { "project-mark--default": !logo }]} aria-hidden="true">
    {logo ? <Image src={logo} alt="" width={128} height={128} /> : <AppWindow size={26} stroke-width={1.5} />}
  </span>

  <div class="project-body">
    <div class="project-heading">
      <Heading class="project-title">
        {
          variant === "featured" && primaryUrl ? (
            <a href={primaryUrl} class="project-link" target="_blank" rel="noopener noreferrer">
              {title}
              <span class="sr-only">{` (${t("links.opensInNewTab")})`}</span>
            </a>
          ) : (
            title
          )
        }
      </Heading>
      {decommissioned && <Tag tone="rose">{t("projects.decommissioned")}</Tag>}
    </div>

    <p class="project-description">{description}</p>
    {disclaimer && variant === "full" && <p class="project-disclaimer">{disclaimer}</p>}
    {
      highlights && variant === "full" && (
        <ul class="project-highlights" role="list">
          {highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      )
    }

    <ul class="project-stack" role="list" aria-label={`${title} ${t("projects.technologies")}`}>
      {
        shownStack.map((tech) => (
          <li>
            <Tag>{tech}</Tag>
          </li>
        ))
      }
    </ul>

    {
      variant === "full" && hasActions && (
        <div class="project-actions">
          {siteUrl && (
            <ButtonLink href={siteUrl} icon="external" external>
              {t("projects.visit")}
              <span class="sr-only">{` ${title}`}</span>
            </ButtonLink>
          )}
          {releasesUrl && (
            <a href={releasesUrl} class="project-text-link" target="_blank" rel="noopener noreferrer">
              <Download size={16} aria-hidden="true" />
              {t("projects.download")}
              <span class="sr-only">{` ${title} (${t("links.opensInNewTab")})`}</span>
            </a>
          )}
          {githubUrl && (
            <a href={githubUrl} class="project-text-link" target="_blank" rel="noopener noreferrer">
              <Code size={16} aria-hidden="true" />
              {t("projects.source")}
              <span class="sr-only">{` ${title} (${t("links.opensInNewTab")})`}</span>
            </a>
          )}
        </div>
      )
    }
  </div>

  {
    variant === "featured" && primaryUrl && (
      <span class="project-arrow" aria-hidden="true">
        <ArrowUpRight size={20} />
      </span>
    )
  }
</article>

<style>
  .project {
    position: relative;
    display: grid;
    align-items: start;
    gap: 1.25rem;
    height: 100%;
    border-radius: 3px;
  }

  .project-body {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .project-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .project-title {
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .project-description {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Official app icon, or a default icon on a tile of the same size. */
  .project-mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border-radius: 22%;
  }

  .project-mark :global(img) {
    width: 100%;
    height: 100%;
  }

  .project-mark--default {
    border: 1px solid var(--rule);
    background-color: color-mix(in oklab, var(--ink) 6%, transparent);
    color: var(--ink-muted);
  }

  /* Featured: dark panel; the whole card links to the project. */
  .project--featured {
    --ink: var(--panel-ink);
    --ink-muted: color-mix(in oklab, var(--color-ivory) 72%, transparent);
    --rule: color-mix(in oklab, var(--color-ivory) 28%, transparent);

    grid-template-rows: auto 1fr;
    padding: 1.5rem;
    background-color: var(--panel);
    color: var(--ink);
  }

  .project--featured .project-stack {
    margin-top: 0.25rem;
  }

  .project-link::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .project-link:focus-visible {
    outline: none;
  }

  /* The focus ring is drawn outside the card, on the page: it keeps the page focus colour. */
  .project--featured:has(.project-link:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .project-arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    transition: translate var(--duration-quick) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .project--featured:hover .project-arrow {
      translate: var(--nudge) calc(var(--nudge) * -1);
    }

    .project--featured:hover .project-title {
      text-decoration-line: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.15em;
    }
  }

  /* Full: icon beside the details, on a raised ivory surface. */
  .project--full {
    grid-template-columns: auto 1fr;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    background-color: color-mix(in oklab, var(--surface-raised) 45%, transparent);
  }

  .project-disclaimer {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    font-style: italic;
  }

  .project-highlights {
    display: grid;
    gap: 0.25rem;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    list-style: disc;
  }

  .project-highlights li::marker {
    color: var(--ink-muted);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 0.5rem;
  }

  .project-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-text-link:hover {
      text-decoration-line: underline;
      text-underline-offset: 0.25em;
    }
  }

  @media (min-width: 40rem) {
    .project--full {
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .project--full .project-mark {
      width: 4rem;
      height: 4rem;
    }
  }
</style>
