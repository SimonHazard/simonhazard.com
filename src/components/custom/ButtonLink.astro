---
import { ArrowDown, ArrowRight, ArrowUpRight, Download } from "@lucide/astro";
import { t } from "@/i18n/utils";

const icons = {
  "arrow-right": ArrowRight,
  "arrow-down": ArrowDown,
  external: ArrowUpRight,
  download: Download,
} as const;

interface Props {
  href: string;
  variant?: "primary" | "secondary";
  icon?: keyof typeof icons;
  /** Download the target instead of navigating to it. */
  download?: boolean;
  /** Open in a new tab; announced to screen readers. */
  external?: boolean;
}

const { href, variant = "primary", icon, download = false, external = false } = Astro.props;
const Icon = icon ? icons[icon] : undefined;
---

<a
  href={href}
  class:list={["btn", `btn--${variant}`]}
  download={download || undefined}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot />
  {external && <span class="sr-only">{` (${t("links.opensInNewTab")})`}</span>}
  {Icon && <span class="btn-icon"><Icon size={18} aria-hidden="true" /></span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    font-size: 1rem;
    line-height: 1.2;
    white-space: nowrap;
    transition:
      background-color var(--duration-quick) ease,
      color var(--duration-quick) ease,
      scale var(--duration-quick) var(--ease-out);
  }

  .btn--primary {
    background-color: var(--ink);
    color: var(--surface-page);
  }

  .btn--secondary {
    background-color: color-mix(in oklab, var(--surface-page) 88%, transparent);
    color: var(--ink);
  }

  .btn-icon {
    display: inline-flex;
    transition: translate var(--duration-quick) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn--primary:hover {
      background-color: var(--ink-muted);
    }

    .btn--secondary:hover {
      background-color: var(--surface-raised);
    }

    .btn:hover .btn-icon {
      translate: var(--nudge) 0;
    }
  }

  .btn:active {
    scale: var(--press-scale);
  }
</style>
