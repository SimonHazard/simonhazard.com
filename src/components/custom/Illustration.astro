---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Composition {
  image: ImageMetadata;
  /** CSS `object-position` used when the frame crops the image. */
  position?: string;
}

interface Props {
  /** Composition for wide screens, or for every screen when `mobile` is absent. */
  desktop: Composition;
  /** Optional art-directed composition used below the desktop breakpoint. */
  mobile?: Composition;
  /** Empty for decorative illustrations. */
  alt?: string;
  sizes?: string;
  /** Candidate widths for the srcset; capped at the source width. */
  widths?: readonly number[];
  /** Load immediately with high priority: only for the main above-the-fold image. */
  priority?: boolean;
  class?: string;
}

/** Keep in sync with the media query in the styles below. */
const DESKTOP_MEDIA = "(min-width: 64rem)";
const DEFAULT_WIDTHS = [480, 768, 1024, 1440, 1920, 2560];
const FORMATS = ["avif", "webp"] as const;

const {
  desktop,
  mobile,
  alt = "",
  sizes = "100vw",
  widths = DEFAULT_WIDTHS,
  priority = false,
  class: className,
} = Astro.props;

function widthsFor(image: ImageMetadata): number[] {
  const candidates = widths.filter((width) => width < image.width);
  return candidates.length === widths.length ? [...candidates] : [...candidates, image.width];
}

async function sourcesFor(composition: Composition, media: string | undefined) {
  const { image } = composition;
  return Promise.all(
    FORMATS.map(async (format) => {
      const result = await getImage({ src: image, widths: widthsFor(image), format });
      return {
        media,
        type: `image/${format}`,
        srcset: result.srcSet.attribute,
        width: image.width,
        height: image.height,
      };
    }),
  );
}

const sources = mobile
  ? [...(await sourcesFor(desktop, DESKTOP_MEDIA)), ...(await sourcesFor(mobile, undefined))]
  : await sourcesFor(desktop, undefined);

// Only used by browsers that ignore every <source>: a single mid-size WebP is enough.
const fallbackImage = (mobile ?? desktop).image;
const fallback = await getImage({
  src: fallbackImage,
  width: Math.min(1024, Math.max(...widths), fallbackImage.width),
  format: "webp",
});

const positions = [
  `--illustration-position: ${(mobile ?? desktop).position ?? "50% 50%"}`,
  `--illustration-position-desktop: ${desktop.position ?? "50% 50%"}`,
].join("; ");
---

<picture class:list={["illustration", className]} style={positions}>
  {
    sources.map((source) => (
      <source
        media={source.media}
        type={source.type}
        srcset={source.srcset}
        sizes={sizes}
        width={source.width}
        height={source.height}
      />
    ))
  }
  <img
    src={fallback.src}
    width={fallbackImage.width}
    height={fallbackImage.height}
    alt={alt}
    loading={priority ? "eager" : "lazy"}
    decoding={priority ? "sync" : "async"}
    fetchpriority={priority ? "high" : undefined}
  />
</picture>

<style>
  .illustration {
    display: block;
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--illustration-position);
  }

  @media (min-width: 64rem) {
    img {
      object-position: var(--illustration-position-desktop);
    }
  }
</style>
