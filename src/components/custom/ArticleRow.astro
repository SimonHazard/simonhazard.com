---
import { ArrowRight, FileText } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { t } from "@/i18n/utils";
import { formatDate } from "@/lib/utils";
import Tag from "./Tag.astro";

interface Props {
  href: string;
  article: CollectionEntry<"articles">["data"];
  /** `compact` for the home page, `full` for article lists. */
  variant: "compact" | "full";
  headingLevel?: "h2" | "h3";
}

const { href, article, variant, headingLevel = "h3" } = Astro.props;
const { title, description, date, lang, tags, ai } = article;
const Heading = headingLevel;
const langLabel = lang === "fr" ? t("lang.fr") : t("lang.en");
---

<article class:list={["article-row", `article-row--${variant}`]}>
  {
    variant === "compact" && (
      <span class="row-icon" aria-hidden="true">
        <FileText size={22} stroke-width={1.5} />
      </span>
    )
  }

  <div class="row-meta">
    <time datetime={date.toISOString()}>{formatDate(date, "en")}</time>
    {
      variant === "full" && (
        <Tag>
          <span aria-hidden="true">{lang.toUpperCase()}</span>
          <span class="sr-only">{langLabel}</span>
        </Tag>
      )
    }
  </div>

  <div class="row-main">
    <div class="row-heading">
      <Heading class="row-title">
        <a href={href} class="row-link" lang={lang}>{title}</a>
      </Heading>
      {variant === "full" && ai && <Tag tone="lavender">{t("articles.aiAssisted")}</Tag>}
    </div>
    {
      variant === "full" && (
        <>
          <p class="row-description" lang={lang}>
            {description}
          </p>
          <ul class="row-tags" role="list">
            {tags.map((tag) => (
              <li>
                <Tag>{tag}</Tag>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>

  <span class="row-arrow" aria-hidden="true">
    <ArrowRight size={22} stroke-width={1.5} />
  </span>
</article>

<style>
  .article-row {
    position: relative;
    display: grid;
    align-items: start;
    height: 100%;
  }

  .row-link::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .row-link:focus-visible {
    outline: none;
  }

  .article-row:has(.row-link:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  .row-title {
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    line-height: 1.15;
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .row-arrow {
    color: var(--ink-muted);
    transition: translate var(--duration-quick) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .article-row:hover .row-title {
      text-decoration-line: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.15em;
    }

    .article-row:hover .row-arrow {
      translate: var(--nudge) 0;
    }
  }

  /* Compact: icon, title, date. */
  .article-row--compact {
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "icon main arrow" "icon meta arrow";
    gap: 0.35rem 1rem;
    padding-block: 1.25rem;
  }

  .article-row--compact .row-icon {
    grid-area: icon;
    padding-top: 0.2rem;
    color: var(--ink-muted);
  }

  .article-row--compact .row-main {
    grid-area: main;
  }

  .article-row--compact .row-meta {
    grid-area: meta;
  }

  .article-row--compact .row-arrow {
    grid-area: arrow;
    align-self: center;
  }

  .article-row--compact .row-title {
    font-size: 1.375rem;
  }

  /* Full: date and language, then title, description and tags. */
  .article-row--full {
    grid-template-columns: 1fr auto;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem;
  }

  .article-row--full .row-main {
    display: grid;
    gap: 0.6rem;
  }

  .row-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .row-description {
    max-width: 48rem;
    color: var(--ink-muted);
  }

  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .article-row--full .row-meta {
    grid-column: 1 / -1;
  }

  .article-row--full .row-arrow {
    grid-row: 2;
    grid-column: 2;
    align-self: center;
  }

  @media (min-width: 48rem) {
    .article-row--full {
      grid-template-columns: 11rem 1fr auto;
    }

    .article-row--full .row-meta {
      grid-column: 1;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0.45rem;
    }

    .article-row--full .row-arrow {
      grid-row: 1;
      grid-column: 3;
    }
  }
</style>
