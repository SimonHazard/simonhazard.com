---
import { isCurrentPath } from "@/data/navigation";
import { t } from "@/i18n/utils";

const current = isCurrentPath("/", Astro.url.pathname);
---

<a href="/" class="wordmark" aria-label={t("site.home")} aria-current={current ? "page" : undefined}>
  {t("site.name")}
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--type-display);
    font-size: 1.375rem;
    letter-spacing: 0.03em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
