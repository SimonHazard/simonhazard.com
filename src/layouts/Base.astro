---
import { Font, getImage } from "astro:assets";
import SiteFooter from "@/components/custom/SiteFooter.astro";
import SiteHeader from "@/components/custom/SiteHeader.astro";
import { illustrations } from "@/data/illustrations";
import { t } from "@/i18n/utils";
import "@/styles/global.css";

interface Props {
  /** Page title; omitted on the home page, which uses the site name and role. */
  title?: string;
  description?: string;
  /** Share image path; defaults to a crop of the hero illustration. */
  ogImage?: string;
  /** Set on article pages to describe them as articles to link previews. */
  article?: { publishedTime: Date; lang: "fr" | "en" };
}

const { title, description = t("meta.defaultDescription"), ogImage, article } = Astro.props;

const pageTitle = title ? `${title} — ${t("site.name")}` : `${t("site.name")} — ${t("site.role")}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Default share card: the hero illustration cropped to the 1200 × 630 link preview format.
const OG_SIZE = { width: 1200, height: 630 } as const;
const defaultOgImage = await getImage({
  src: illustrations.heroDesktop,
  ...OG_SIZE,
  fit: "cover",
  // sharp only accepts keywords here; "right" keeps the observatory and the traveller.
  position: "right",
  format: "jpg",
});
const resolvedOgImage = new URL(ogImage ?? defaultOgImage.src, Astro.site);
const locale = article?.lang === "fr" ? "fr_FR" : "en_US";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:site_name" content={t("site.name")} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content={locale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    {
      !ogImage && (
        <>
          <meta property="og:image:width" content={String(OG_SIZE.width)} />
          <meta property="og:image:height" content={String(OG_SIZE.height)} />
        </>
      )
    }
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="icon" href="/favicon.ico?v=sh-monogram" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-sh-32.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon-sh.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=sh-monogram" />

    <Font cssVariable="--font-newsreader" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-hanken-grotesk" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-jetbrains-mono" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        document.documentElement.classList.toggle("dark", localStorage.getItem("theme") === "dark");
      } catch {
        /* Light is the default when storage is unavailable. */
      }
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-to-content" href="#main-content">{t("site.skipToContent")}</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-to-content {
    position: fixed;
    top: 0.75rem;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background-color: var(--ink);
    color: var(--surface-page);
    translate: 0 -160%;
  }

  .skip-to-content:focus {
    translate: 0 0;
  }

  main:focus {
    outline: none;
  }
</style>
